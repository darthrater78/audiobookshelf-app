<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 (API 31) and higher. Keep in sync with backup_rules.xml -->
<data-extraction-rules>
  <cloud-backup>
    <!-- Paper DB "device" book: server connection configs, including access tokens -->
    <exclude domain="file" path="device/" />
    <!-- Refresh tokens, encrypted with a Keystore key that is never backed up -->
    <exclude domain="sharedpref" path="SecureStorage.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="file" path="device/" />
    <exclude domain="sharedpref" path="SecureStorage.xml" />
  </device-transfer>
</data-extraction-rules>
